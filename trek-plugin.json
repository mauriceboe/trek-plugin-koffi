{
  "id": "koffi",
  "name": "Koffi & Friends",
  "version": "3.0.0",
  "apiVersion": 1,
  "author": "TREK",
  "description": "Dashboard widget: Koffi the trolley, Chiki the konbini chicken, Passi the passport and Puffi the neck pillow walk in 3D along the boarding pass of your next trip. Pick one, or a duo.",
  "homepage": "https://github.com/mauriceboe/trek-plugin-koffi",
  "license": "MIT",
  "icon": "Luggage",
  "type": "widget",
  "trek": ">=3.5.0",
  "nativeModules": false,
  "permissions": [
    "db:read:trips",
    "db:own"
  ],
  "capabilities": {
    "widget": {
      "title": "Koffi & Friends",
      "slot": "hero"
    },
    "settingsUi": true
  },
  "routes": [
    {
      "method": "GET",
      "path": "/state",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/mascots",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/mascots",
      "auth": true
    }
  ]
}
