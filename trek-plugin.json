{
  "id": "koffi",
  "name": "Koffi & Friends",
  "version": "2.0.1",
  "apiVersion": 1,
  "author": "TREK",
  "description": "The TREK mascot troupe on your boarding pass: Koffi the suitcase, Chiki the snack, Passi the passport, Puffi the neck pillow. Pick one, or a duo that naps and stamps together.",
  "homepage": "https://github.com/mauriceboe/trek-plugin-koffi",
  "license": "MIT",
  "icon": "Luggage",
  "type": "widget",
  "trek": ">=3.5.0",
  "nativeModules": false,
  "permissions": [
    "db:read:trips",
    "db:own"
  ],
  "capabilities": {
    "widget": {
      "title": "Koffi & Friends",
      "slot": "hero"
    },
    "settingsUi": true
  },
  "routes": [
    {
      "method": "GET",
      "path": "/state",
      "auth": true
    },
    {
      "method": "GET",
      "path": "/mascots",
      "auth": true
    },
    {
      "method": "POST",
      "path": "/mascots",
      "auth": true
    }
  ]
}
